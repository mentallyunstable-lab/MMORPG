; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited via code if needed.

[application]

config/name="Ashborn"
config/description="Action RPG - Reshape reality through Faith, Truth, or Violence."
run/main_scene="res://scenes/world/test_zone.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
ForceEffects="*res://scripts/autoload/force_effects.gd"
FactionManager="*res://scripts/autoload/faction_manager.gd"
GodManager="*res://scripts/autoload/god_manager.gd"
WorldEventManager="*res://scripts/autoload/world_event_manager.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
ItemManager="*res://scripts/autoload/item_manager.gd"
WorldManager="*res://scripts/autoload/world_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

